# Chain Matrix Multiplication using Dynamic Programming

n = int(input("Enter number of matrices: "))

print("Enter the dimensions:")
p = list(map(int, input().split()))

# DP table
dp = [[0 for _ in range(n)] for _ in range(n)]

# Chain length
for length in range(2, n + 1):
    for i in range(1, n - length + 2):
        j = i + length - 1
        dp[i - 1][j - 1] = float('inf')

        for k in range(i, j):
            cost = (
                dp[i - 1][k - 1]
                + dp[k][j - 1]
                + p[i - 1] * p[k] * p[j]
            )

            if cost < dp[i - 1][j - 1]:
                dp[i - 1][j - 1] = cost

print("Minimum number of scalar multiplications =", dp[0][n - 1])
